{
  "name": "brahma-screen-ocr",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop screen OCR using the exact Tesseract.js engine and language assets bundled with Brahma.",
  "author": "Brahma",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "copy-ocr": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "test:ocr": "node scripts/test-ocr.mjs",
    "test:math": "node scripts/test-math.mjs",
    "test:table": "node scripts/test-table.mjs",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.34.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.brahma.screenocr",
    "productName": "Brahma Screen OCR",
    "asar": false,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ocr-engine.js",
      "math-engine.js",
      "table-engine.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "overlay.html",
      "overlay.js",
      "overlay.css",
      "ocr/**/*",
      "models/**/*",
      "icon128.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Brahma-Screen-OCR-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
